# Copy to .env.local for local development.
#
# Vite only exposes variables prefixed VITE_, and it inlines them at BUILD time
# rather than reading them at runtime -- so changing this in Vercel requires a
# redeploy, not just a restart.

# Local: whatever `uvicorn src.api:app --reload` is serving.
VITE_API_BASE=http://127.0.0.1:8000

# Production: the deployed API, e.g.
# VITE_API_BASE=https://celeb-lookalike-api.onrender.com
